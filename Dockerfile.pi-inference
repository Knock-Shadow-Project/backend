# syntax=docker/dockerfile:1
FROM python:3.14-slim

WORKDIR /app

# No compilers needed: torch/numpy/scipy/pandas all ship aarch64 wheels.
# Adding gcc here would bloat the image and was only there to fall back on
# source builds we never want on the Pi.

# Install lightweight deps first (own layer for caching).
COPY ml/requirements_inference.txt .
RUN pip install --no-cache-dir -r requirements_inference.txt

# Install CPU-only torch from PyTorch's index. The default PyPI wheels for
# linux bundle nvidia-cublas / nvidia-cuda-runtime / nvidia-cudnn, blowing the
# image up by ~2 GB; the cpu index ships a single ~200 MB wheel with no CUDA.
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    "torch>=2.9"

# Copy only what the inference path imports. train.py is intentionally NOT
# copied — it pulls matplotlib / seaborn / scikit-learn that the Pi never uses.
# `pipeline` is now a package (split in Phase C: _constants/_io/_signal/_detect/
# _dataset). `logging_config` + `model_loader` were also extracted from
# pi_inference.py and main.py, so both have to land in the image.
COPY ml/model_def.py ml/logging_config.py ml/model_loader.py ml/pi_inference.py ./
COPY ml/pipeline/ ./pipeline/
COPY ml/model/ ./model/

ENV DB_PATH=/data/pi_data.db
ENV PYTHONUNBUFFERED=1

CMD ["python", "pi_inference.py", "--user-id", "1"]
