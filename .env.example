# =============================================================================
# KnockShadow — Variables de entorno de ejemplo
# =============================================================================
# Copia este archivo a `.env` (gitignorado) y rellena los valores reales.
# `docker-compose.yaml` lee `.env` automáticamente cuando arrancas el stack.
#
# Para producción: usa un gestor de secretos (Vault, Doppler, AWS SM, etc.)
# en vez de un `.env` en disco.
# =============================================================================

# -----------------------------------------------------------------------------
# api-db (Rust REST + WebSocket)
# -----------------------------------------------------------------------------

# JWT signing key. Mínimo 32 caracteres. Genera uno con:
#   openssl rand -hex 32
JWT_SECRET=cambiame_minimo_32_caracteres_de_entropia_real

# Resend — envío real de emails transaccionales (confirmación de cuenta).
# Si lo dejas vacío, api-db arranca igual pero los emails se loggean en
# vez de enviarse (modo stub).
#
# Crea/rota tu clave en: https://resend.com/api-keys
RESEND_API_KEY=

# Buzón "From" usado al enviar emails. Debe pertenecer a un dominio
# verificado en Resend o el envío fallará con 403.
RESEND_FROM="KnockShadow <no-reply@knockshadow.site>"

# Base URL del frontend, usada para construir los enlaces del email
# (`{APP_BASE_URL}/confirm-email?token=...`).
APP_BASE_URL=https://api.knockshadow.site

# Rate-limit distribuido (opcional). Si está vacío, api-db usa un
# `HashMap` en memoria, suficiente para un solo pod. Cuando arranques
# múltiples instancias detrás de un balanceador, apúntalo a tu Valkey
# (o Redis OSS): `redis://host:6379/`. El stack `docker-compose.yaml`
# levanta un Valkey local en `valkey:6379` que puedes usar por defecto.
REDIS_URL=redis://valkey:6379/

# -----------------------------------------------------------------------------
# Observabilidad (Grafana admin login)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
