# syntax=docker/dockerfile:1
FROM rust:1.96-bookworm AS builder

# Install build dependencies for btleplug (BlueZ / D-Bus)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-dev libbluetooth-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace manifests
COPY Cargo.toml Cargo.lock ./
COPY crates/api-db/Cargo.toml ./crates/api-db/
COPY crates/bt-reader/Cargo.toml ./crates/bt-reader/
COPY crates/pi-service/Cargo.toml ./crates/pi-service/

# Create dummy sources to cache dependencies
RUN mkdir -p crates/api-db/src && echo 'fn main(){}' > crates/api-db/src/main.rs
RUN mkdir -p crates/bt-reader/src && echo 'fn main(){}' > crates/bt-reader/src/main.rs
RUN mkdir -p crates/pi-service/src && echo 'fn main(){}' > crates/pi-service/src/main.rs

# Build dependencies (this layer is cached if manifests don't change)
RUN cargo build -p ble-stream --release || true

# Copy real sources
COPY crates/bt-reader/src ./crates/bt-reader/src

# Build the real binary
RUN cargo build -p ble-stream --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-3 libbluetooth3 bluez \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/ble-stream /usr/local/bin/ble-stream

ENV RUST_LOG=info
ENV DEVICE_MAC=DF:65:81:D0:D7:E5
ENV DATABASE_URL=postgres://knockshadow:knockshadow@db:5432/knockshadow

# Note: Bluetooth inside Docker requires privileged mode and D-Bus socket mount.
# See docker-compose.yml for the required configuration.
CMD ["ble-stream"]
