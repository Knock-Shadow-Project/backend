# syntax=docker/dockerfile:1
FROM rust:1.97-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace manifests
COPY Cargo.toml Cargo.lock ./
COPY crates/api-db/Cargo.toml ./crates/api-db/
COPY crates/bt-reader/Cargo.toml ./crates/bt-reader/
COPY crates/pi-service/Cargo.toml ./crates/pi-service/

# Create dummy sources to cache dependencies
RUN mkdir -p crates/api-db/src && echo 'fn main(){}' > crates/api-db/src/main.rs
RUN mkdir -p crates/bt-reader/src && echo 'fn main(){}' > crates/bt-reader/src/main.rs
RUN mkdir -p crates/pi-service/src && echo 'fn main(){}' > crates/pi-service/src/main.rs

# Build dependencies (this layer is cached if manifests don't change)
RUN cargo build -p api-db --release || true

# Copy real sources
COPY crates/api-db/src ./crates/api-db/src

# Force cargo to rebuild after source copy (update mtimes so cargo detects changes)
RUN find crates/api-db/src -name '*.rs' -exec touch {} + && cargo build -p api-db --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/api-db /usr/local/bin/api-db

EXPOSE 3000
ENV PORT=3000
ENV RUST_LOG=debug

CMD ["api-db"]
