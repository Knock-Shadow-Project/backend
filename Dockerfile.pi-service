# syntax=docker/dockerfile:1
FROM rust:1.94-bookworm AS builder

# Install build dependencies for btleplug (BlueZ / D-Bus) + reqwest (openssl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-dev libbluetooth-dev libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace manifests
COPY Cargo.toml Cargo.lock ./
COPY crates/api-db/Cargo.toml ./crates/api-db/
COPY crates/bt-reader/Cargo.toml ./crates/bt-reader/
COPY crates/pi-service/Cargo.toml ./crates/pi-service/

# Create dummy sources to cache dependencies
RUN mkdir -p crates/api-db/src && echo 'fn main(){}' > crates/api-db/src/main.rs
RUN mkdir -p crates/bt-reader/src && echo 'fn main(){}' > crates/bt-reader/src/main.rs
RUN mkdir -p crates/pi-service/src && echo 'fn main(){}' > crates/pi-service/src/main.rs

# Build dependencies (this layer is cached if manifests don't change)
RUN cargo build -p pi-service --release || true

# Copy real sources
COPY crates/pi-service/src ./crates/pi-service/src

# Force Cargo to rebuild pi-service (invalidate cached dummy artifacts)
RUN touch crates/pi-service/src/main.rs && \
    rm -f target/release/pi-service target/release/deps/pi_service* 2>/dev/null; \
    cargo build -p pi-service --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-3 libbluetooth3 bluez libssl3 ca-certificates \
    avahi-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/pi-service /usr/local/bin/pi-service

EXPOSE 8080

ENV PORT=8080
ENV DB_PATH=/data/pi_data.db
ENV RUST_LOG=info

# Note: Bluetooth inside Docker requires privileged mode and D-Bus socket mount.
# See docker-compose.pi.yml for the required configuration.
CMD ["pi-service"]
